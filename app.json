{
  "expo": {
    "name": "LookBoogie",
    "slug": "lookboogie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lookboogie",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lookboogie.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "룩부기가 옷 사진을 등록하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "룩부기가 옷 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "6f00dbc3-9703-4f9a-9980-74ff2f72048a"
      }
    },
    "owner": "0xseo"
  }
}
