{
  "expo": {
    "name": "Lookbookie",
    "slug": "lookbookie",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lookbookie",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lookbookie.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "룩북이가 옷 사진을 등록하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": "룩북이가 옷 사진을 촬영하기 위해 카메라에 접근합니다.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
